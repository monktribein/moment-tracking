# Release signing for Google Play.
#
# 1. Create your upload keystore once (keep it and its passwords safe and
#    backed up; you need the same key for every app update):
#
#      keytool -genkey -v -keystore C:/Users/<you>/upload-keystore.jks ^
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
#    (keytool comes with Android Studio: <Android Studio>/jbr/bin/keytool.exe)
#
# 2. Copy this file to android/key.properties and fill in your values.
#    key.properties and *.jks are in .gitignore: never commit or share them.
#
# 3. Build: flutter build appbundle

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=C:/Users/<you>/upload-keystore.jks

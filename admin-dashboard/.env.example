# The backend API this dashboard talks to (ends in /api). Copy to .env to change it.
# Local backend: http://localhost:5100/api
# Production: your Render URL, e.g. https://movement-tracking-api.onrender.com/api
VITE_API_URL=http://localhost:5100/api

# Google Maps for Live tracking (browser key; restrict it to your dashboard's address in Google Cloud).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own map ID from Google Cloud (Map management). Empty = Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

# Eco Sor screens (staff, HR, sales, support) and the distributor portal (/#/portal) use the same
# VITE_API_URL: they call its /v1/* routes. Nothing else to configure here.
# Visit check-in maps reuse VITE_GOOGLE_MAPS_API_KEY above (without a key the map shows an error; the "Open in Google Maps" link still works).
# Backend side: private payment proofs need STORAGE_* and WhatsApp codes need WHATSAPP_* in backend/.env.

# Phone number shown in the sidebar "Need help?" card (leave empty to hide the card), e.g. +91 98765 43210
VITE_SUPPORT_PHONE=

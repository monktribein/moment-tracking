# The backend API this dashboard talks to (ends in /api). Copy to .env to change it.
# Local backend: http://localhost:5100/api
# Production: your Render URL, e.g. https://movement-tracking-api.onrender.com/api
VITE_API_URL=http://localhost:5100/api

# Google Maps for Live tracking (browser key; restrict it to your dashboard's address in Google Cloud).
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own map ID from Google Cloud (Map management). Empty = Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=

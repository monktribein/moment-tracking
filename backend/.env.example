# Movement Tracking API — copy to .env and fill in. Placeholders only; never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
# The API's port (Render and most hosts set PORT themselves).
PORT=5100
# Comma-separated web origins allowed to call the API (required in production).
# Local http://localhost:* is always allowed outside production. Native apps send no origin.
CORS_ORIGINS=
# true when running behind nginx / a load balancer.
TRUST_PROXY=false
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Optional: DNS servers for Node (comma-separated), e.g. when the ISP DNS cannot resolve the DB host.
DNS_SERVERS=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Database (its own Postgres) ───────────────────────────────────────────────
# Supabase: use the Session pooler URL (port 5432). Local: postgresql://postgres:postgres@localhost:5432/movement_tracking?sslmode=disable
SUPABASE_DB_URL=
# Optional: direct URL for npm run db:migrate (falls back to SUPABASE_DB_URL).
SUPABASE_MIGRATION_URL=
SUPABASE_POOL_MAX=10
SUPABASE_TTL_SWEEP=true

# ── Admin console (platform owner + Super Admins) ─────────────────────────────
# Signs platform owner and Super Admin tokens. 32+ random characters (required in production).
JWT_SECRET=
JWT_EXPIRES_IN=12h
JWT_ISSUER=movement-tracking-api
JWT_AUDIENCE=movement-tracking-admin
# Platform owner (the higher authority): created at startup only while no platform owner exists.
# It signs in with this email and password and creates each company with its Super Admin
# (POST /api/platform/companies). Super Admins are no longer created from .env.
# Changing these later does NOT change the existing account (use POST /api/auth/change-password).
PLATFORM_OWNER_NAME=Platform Owner
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=

# ── Field agents (lead app) ───────────────────────────────────────────────────
# Signs field-agent tokens. Use a different value from JWT_SECRET.
LEAD_JWT_SECRET=
LEAD_JWT_EXPIRES_IN=12h
LEAD_JWT_ISSUER=movement-tracking-lead-api
LEAD_JWT_AUDIENCE=movement-tracking-field-agents
LEAD_BCRYPT_ROUNDS=10
# Shifts still open 9 hours after check-in are closed every 5 minutes. false switches it off.
LEAD_AUTO_CHECKOUT_ENABLED=true

# ── File uploads (lead photos / documents) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=movement-tracking

# ── Eco Sor Business Operations Platform (/api/v1/*) ──────────────────────────
# Sign-in tokens use JWT_SECRET / JWT_ISSUER / JWT_AUDIENCE above. A user's session ends after this long.
ECO_JWT_EXPIRES_IN=8h
ECO_BCRYPT_ROUNDS=10
# The customer app's company when the platform hosts several (otherwise the only active company is used).
CUSTOMER_COMPANY_ID=
# Extra connections for the SQL-managed Eco Sor tables (shares SUPABASE_DB_URL).
ECO_PG_POOL_MAX=5

# One-time codes (customer registration, password reset, complaint closure)
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=3
OTP_BCRYPT_ROUNDS=8
# After a code is verified, the complaint can be closed for this many minutes.
OTP_CLOSE_WINDOW_MINUTES=30

# WhatsApp: log (development: messages are only written to the log) | meta | interakt | gupshup
WHATSAPP_PROVIDER=log
# Credentials stay here, never in the database. meta: WHATSAPP_API_KEY = permanent access token.
# interakt: WHATSAPP_API_KEY = the Base64 API key. gupshup: WHATSAPP_API_KEY = apikey, WHATSAPP_SENDER = source number.
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SENDER=
WHATSAPP_APP_NAME=
WHATSAPP_COUNTRY_CODE=91
WHATSAPP_LANGUAGE=en
WHATSAPP_TIMEOUT_MS=10000
# Failed messages are retried up to 3 times by a job that runs every minute. false switches it off.
WHATSAPP_RETRY_ENABLED=true
# Template per event defaults to the event name (e.g. request_approved); override with WHATSAPP_TEMPLATE_<EVENT>, e.g.:
# WHATSAPP_TEMPLATE_SERVICE_OTP=eco_service_otp

# Private files (payment proofs, receipts, complaint photos): local (development) | s3 (any S3-compatible bucket, e.g. Supabase Storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
# Signed links last this long. The signing secret defaults to JWT_SECRET.
STORAGE_URL_TTL_SECONDS=300
STORAGE_SIGNING_SECRET=
# Where the API is reached, for local signed links (default http://localhost:PORT).
STORAGE_PUBLIC_BASE_URL=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
